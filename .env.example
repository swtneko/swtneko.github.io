# Google Gemini API Key(s)
# Hỗ trợ điền 1 key hoặc nhiều key cách nhau bằng dấu phẩy để tự động xoay tua dự phòng (VD: key1,key2,key3)
# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEYS=

# DeepSeek API Key (Tùy chọn - Dự phòng hoặc dùng riêng)
# Lấy tại https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Groq API Key (Tùy chọn - Tốc độ siêu nhanh, có gói miễn phí cao)
# Lấy miễn phí tại https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key (Tùy chọn - Dùng GPT-4o mini)
# Lấy tại https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter API Key (Tùy chọn - Truy cập hàng trăm AI models)
# Lấy tại https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 9Router VPS (OpenAI-compatible Router tự host trên VPS)
NINEROUTER_API_KEY=
NINEROUTER_API_BASE=https://your-vps-9router.com/v1

# Firebase Configuration (Tùy chọn khi deploy Vercel/môi trường ngoài)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
