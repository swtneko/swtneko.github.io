rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'nekyohotaru@gmail.com' ||
          request.auth.token.email == 'elmo44348@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Allow test connection
    match /test/{docId} {
      allow read, write: if true;
    }

    // System configurations & announcements (Anyone can read, only admin can write)
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile document
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // User saved readings and follow-ups
      match /readings/{readingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Shared reading links (anyone with the direct link can read)
    match /shared_readings/{readingId} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}

